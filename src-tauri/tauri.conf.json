{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "GSpaceOne PhotoID",
  "version": "0.1.0",
  "identifier": "com.gspaceone.photoid",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GSpaceOne PhotoID",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "center": true
      },
      {
        "label": "settings",
        "title": "Settings",
        "width": 380,
        "height": 680,
        "decorations": true,
        "alwaysOnTop": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "GSpaceOne (MIT)",
    "copyright": "Copyright © 2026 GSpaceOne (MIT)",
    "targets": [
      "msi",
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/icon.ico": "icon.ico"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installerHooks": "nsis_hooks.nsh"
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.13"
    }
  }
}